# Copy this file to .env and fill in your keys. Never commit .env.

# ===== AI provider API keys (required) =====
GEMINI_API_KEY=
OPENAI_API_KEY=

# ===== Provider selection (spec: vision=gemini, prompt=openai) =====
VISION_PROVIDER=gemini
PROMPT_PROVIDER=openai
ENABLE_FALLBACK=true

# ===== Model names — current-gen defaults, 2026-10-07 =====
# Vision: gemini-3.8-flash is the strongest stable Flash tier ($0.75/$3.75 per 1M tokens
#         until 2026-12-31, then $1.50/$7.50). Swap to gemini-3.5-flash-lite ($0.30/$2.50)
#         for the cheapest capable vision model.
# Prompt: gpt-6-luna ($0.10/$0.50) is OpenAI's cheap current-gen model with vision,
#         Chat Completions and structured-output support.
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_PROMPT_MODEL=gemini-3.1-flash-lite
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_PROMPT_MODEL=gpt-6-luna

# ===== Limits & server =====
# MAX_IMAGE_MB caps the compressed upload; MAX_IMAGE_PIXELS is the decoded
# pixel budget (width x height, e.g. 24MP allows typical phone photos);
# MAX_IMAGE_SIDE caps the longest side sent to the vision model.
MAX_IMAGE_MB=10
MAX_IMAGE_PIXELS=24000000
MAX_IMAGE_SIDE=2048
AI_TIMEOUT_SECONDS=120
# Deterministic AI call budget: primary attempts + fallback attempts.
AI_PRIMARY_ATTEMPTS=2
AI_FALLBACK_ATTEMPTS=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
